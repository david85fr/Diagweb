// Diagweb — environnement GitHub Codespaces.
// Format jsonc : les commentaires font partie de la spécification devcontainer.
{
  "name": "Diagweb — interface et serveur de diagnostic",
  "image": "mcr.microsoft.com/devcontainers/cpp:1-ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" },
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" },
    // tools/share.sh passe le port en public avec « gh codespace ports ».
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // 8080 : aperçu et serveur de diagnostic. 8099 : port des tests de liens
  // réseau (meson test), distinct pour que les deux tournent ensemble.
  "forwardPorts": [8080, 8099],
  "portsAttributes": {
    "8080": {
      "label": "Diagweb (aperçu)",
      "onAutoForward": "notify"
    },
    "8099": {
      "label": "Diagweb (tests)",
      "onAutoForward": "ignore"
    }
  },

  // CAP_NET_RAW : sockets AF_PACKET, indispensables à GOOSE, Sampled Values,
  // LLDP et à la capture. CAP_NET_ADMIN : création d'une interface « vcan »
  // pour éprouver CAN, J1939 et CANopen sans matériel.
  //
  // La capacité est nécessaire mais pas forcément suffisante pour vcan : le
  // module doit exister dans le noyau de l'hôte, ce qu'aucune capacité ne peut
  // compenser. Sonde : « ip link add dev vcan0 type vcan » — « Unknown device
  // type » signifie noyau sans vcan, et il n'y a alors rien à tenter de plus.
  "runArgs": ["--cap-add=NET_RAW", "--cap-add=NET_ADMIN"],

  // Découpage selon la dépendance au dépôt, et non par commodité :
  //
  //   onCreateCommand   outillage système (apt, open62541) — ne lit aucune
  //                     source, donc cuisable dans un prebuild Codespaces,
  //                     qui s'arrête à onCreate/updateContent et ne joue
  //                     JAMAIS postCreateCommand. C'est là que se trouvent les
  //                     minutes de CMake d'open62541.
  //   postCreateCommand ce qui a besoin du code (syntaxe, compilation) et doit
  //                     refléter le commit ouvert, jamais une image figée.
  //
  // Le gain ne se matérialise qu'avec les prebuilds activés sur le dépôt
  // (Settings → Codespaces → Set up prebuilds) ; sans eux les deux crochets se
  // valent, et le découpage reste correct.
  "onCreateCommand": "bash .devcontainer/on-create.sh",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postAttachCommand": {
    "apercu": "nohup python3 tools/serve.py > /tmp/diagweb-serve.log 2>&1 &"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "files.eol": "\n",
        "files.insertFinalNewline": true,
        "files.trimTrailingWhitespace": true,
        "editor.tabSize": 2
      }
    }
  },
  "remoteEnv": {
    "PLAYWRIGHT_BROWSERS_PATH": "${containerWorkspaceFolder}/.pw-browsers",
    // open62541 est installé dans $HOME par post-create.sh ; sans ce chemin,
    // meson ne le trouve pas et le pilote OPC UA redevient « déclaré ».
    // ${containerEnv:HOME} évite de coder en dur l'utilisateur du conteneur.
    "PKG_CONFIG_PATH": "${containerEnv:HOME}/.local/open62541/lib/pkgconfig:${containerEnv:HOME}/.local/open62541/lib64/pkgconfig"
  }
}
